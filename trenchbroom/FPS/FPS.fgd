@SolidClass = worldspawn : "World entity" []

@baseclass size(-16 -16 -24, 16 16 32) color(0 255 0) = PlayerClass []

@PointClass base(PlayerClass) = info_player_start : "Player 1 start" []

@PointClass size(-4 -4 -4, 4 4 4) color(255 255 0) = light : "Light" [
	colour(color1) : "Colour" : "1.0 1.0 1.0"
]

@PointClass model({"path": "models/door.obj", "scale": 1.0/0.01905}) size(0 0 0, 0 0 0) = door : "Door" []
